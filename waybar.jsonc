{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 2,
  "margin-top": 5,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "ext/workspaces",
    "custom/layout",
    "custom/cpucat"
  ],
  "modules-center": [
    "custom/skull"
  ],
  "modules-right": [
    "mpris",
    "group/connectivity",
    "group/system",
    "clock",
    "custom/notifications",
    "custom/power"
  ],
  "custom/layout": {
    "exec": "mmsg watch all-monitors | jq --unbuffered --argjson names '{\"T\": \"Tile\", \"S\": \"Scroller\", \"G\": \"Grid\", \"M\": \"Monocle\", \"K\": \"Deck\", \"CT\": \"Center Tile\", \"RT\": \"Right Tile\", \"VS\": \"Vertical Scroller\", \"VT\": \"Vertical Tile\", \"VG\": \"Vertical Grid\", \"VK\": \"Vertical Deck\", \"DW\": \"Dwindle\", \"F\": \"Fair\", \"VF\": \"Vertical Fair\"}' -c '.monitors[] | select(.active) | ($names[.layout_symbol] // .layout_symbol) as $layout | {text: $layout, tooltip: ($layout + \"\\nSUPER+L: cycle layouts\\nSUPER+CTRL+ALT+1..7: select layout\\nRight-click: overview\")}'",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "restart-interval": 5,
    "on-click": "mmsg dispatch switch_layout",
    "on-click-right": "mmsg dispatch toggleoverview"
  },
  "custom/skull": {
    "exec": "~/.config/mango/scripts/skull.sh",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "ARCHNEMESIS",
    "restart-interval": 5
  },
  "custom/cpucat": {
    "exec": "~/.config/mango/scripts/catloop.sh",
    "tooltip": false,
    "restart-interval": 5
  },
  "mpris": {
    "format": "\uf001  {artist} - {title}",
    "format-paused": "\udb81\udc0a  {artist} - {title}",
    "max-length": 24,
    "player": "spotify",
    "tooltip": true,
    "on-click": "playerctl --player=spotify play-pause",
    "on-click-right": "~/.config/mango/scripts/tui.sh music",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous"
  },
  "custom/network": {
    "format": "\uf1eb",
    "on-click": "~/.config/mango/scripts/tui.sh network",
    "tooltip-format": "Network",
    "tooltip": true
  },
  "custom/bluetooth": {
    "format": "\uf294",
    "on-click": "~/.config/mango/scripts/tui.sh bluetooth",
    "tooltip-format": "Bluetooth",
    "tooltip": true
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": "\udb81\udd7e  {volume}%",
    "format-muted": "\udb81\udf5f  muted",
    "tooltip": true,
    "on-click": "~/.config/mango/scripts/tui.sh audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "max-volume": 100,
    "tooltip-format": "{node_name}\nClick: mixer \u00b7 Right-click: mute \u00b7 Scroll: volume"
  },
  "backlight": {
    "format": "\udb80\udce0  {percent}%",
    "tooltip": true,
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip-format": "Brightness: {percent}%\nScroll to adjust"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "\udb80\udc84  {capacity}%",
    "format-plugged": "\udb85\udc0b  {capacity}%",
    "format-full": "\udb80\udc79  {capacity}%",
    "format-icons": [
      "\udb80\udc8e",
      "\udb80\udc7a",
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7d",
      "\udb80\udc7e",
      "\udb80\udc7f",
      "\udb80\udc80",
      "\udb80\udc81",
      "\udb80\udc82",
      "\udb80\udc79"
    ],
    "tooltip": true,
    "on-click": "~/.config/mango/scripts/tui.sh system"
  },
  "clock": {
    "format": "\uf017  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "~/.config/mango/scripts/tui.sh calendar"
  },
  "custom/notifications": {
    "exec": "~/.config/mango/scripts/notifications.sh",
    "format": "{icon}",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "tooltip-format": "Notifications: {text}\nClick: panel \u00b7 Right-click: Do Not Disturb",
    "tooltip": true,
    "return-type": "json",
    "restart-interval": 5,
    "exec-on-event": false,
    "format-icons": {
      "notification": "\udb80\udc9a",
      "none": "\udb80\udc9c",
      "dnd-notification": "\udb80\udc9b",
      "dnd-none": "\udb82\ude91",
      "inhibited-notification": "\udb80\udc9a",
      "inhibited-none": "\udb80\udc9c",
      "dnd-inhibited-notification": "\udb80\udc9b",
      "dnd-inhibited-none": "\udb82\ude91"
    }
  },
  "reload_style_on_change": true,
  "fixed-center": true,
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "custom/network",
      "custom/bluetooth"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "wireplumber",
      "backlight",
      "battery"
    ]
  },
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-name": true,
    "ignore-hidden": true
  },
  "custom/power": {
    "format": "\uf011",
    "on-click": "bash \"$HOME/.config/mango/scripts/powermenu.sh\"",
    "tooltip-format": "Session and power menu",
    "tooltip": true
  }
}
